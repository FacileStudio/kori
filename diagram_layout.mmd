---
title: "Kori Source Tree & Physical Layout"
---

flowchart TOPO
  kori_api["kori (main entry)"]
  kori_config["Configuration (settings)"]
  kori_state["Persistent state (sessions, logs)"]
  kori_agent["Agent runtime"]
  kori_inside_agent["Systems within agent"]

  %% Top level
  kori_api --> config_config["Configuration layer\n(cmd/*, settings/*)"]
  kori_api --> external_services["External services layer\n(herdr, sonde, journal, courrier)"]

  %% Internal layers
  kori_inside_agent --> storage_storage["Storage layer\n(sql, json)"]
  kori_inside_agent --> tools_layer["Tools layer\n(provider, sandbox)"]
  kori_inside_agent --> workflow_layer["Workflow layer\n(context, approval)"]

  %% Physical organization
  subgraph cmd_directory["cmd/* entry commands - User interface"]
    cmd_root["root.go - Main CLI structure"]
    cmd_sandbox["sandbox go - MicroVM/SSH execution"]
    cmd_sessions["sessions.go - Session management"]
    cmd_audit["audit.go - CI/quality checks"]
    cmd_search["search.go - Memory/skill search"]
  end

  subgraph settings_directory["internal/settings - Configuration loading"]
    config_loader["loader.go - Reads config files"]
    config_paths["paths.go - Determines search order"]
    config_template["template.go - Generates default .kori.yml"]
    config_directive["directive.go - Load directives/overrides"]
  end

  subgraph sandbox_directory["internal/sandbox - Filesystem access"]
    ssh["ssh.go - SSH client & orchestration"]
    remote["remote.go - Remote targets"]
    boite["boite.go - MicroVM instances"]
    exec["exec.go - Command execution in sandbox"]
  end

  subgraph provider_directory["internal/provider - LLM connections"]
    backend["backend.go - Provider interface"]
    catalog["catalog.go - Provider detection"]
    anthropic["anthropic.go - Anthropic API"]
    google["google.go - Google API"]
    openai["openai.go - OpenAI API"]
  end

  subgraph agent_system["internal/agent - Core agent"]
    agent_config["agent_config.go - Agent settings"]
    agent_context["agent.go - Agent lifecycle"]
    agent_env["environment.go - Runtime environment"]
    agent_tools["tools/ - Tool functions"]
  end

  subgraph sessions_system["internal/sessions - Session persistence"]
    session_list["list.go - List sessions"]
    session_run["run.go - Create/Start session"]
    session_resume["resume.go - Resume session"]
    session_persist["persist.go - Save session state"]
  end

  subgraph cost_system["internal/cost - Usage tracking"]
    cost_calc["cost.go - Calculate costs"]
    usage_track["usage.go - Track tokens/usage"]
  end

  subgraph skills_system["internal/skills - Skill discovery"]
    skill_load["load.go - Load skill files"]
    skill_exec["exec.go - Execute skill logic"]
    skill_discovery["discover.go - Discover skills"]
  end

  subgraph compaction_system["internal/compaction - History management"]
    plan["plan.go - Compaction plan"]
    apply["apply.go - Apply changes"]
    judge["judge.go - Audit changes"]
    ledger["ledger.go - Persistent state"]
    tombstone["tombstone.go - Garbage collection"]
  end

  subgraph history_system["internal/history - Event logging"]
    jev["jev.go - Structured logging"]
    tracer["tracer.go - Trace execution"]
    transcript["transcript.go - Transcript storage"]
  end

  subgraph tui_layer["tui/ - Terminal UI"]
    command_model["command_model.go - Model definition"]
    layout["layout.go - Screen layout"]
    theme["theme.go - Styling"]
    render["render.go - Rendering"]
    input_handler["input_handler.go - Input processing"]
    slash_command["slash_command.go - / commands"]
    grind["grind.go - Costs/grind controls"]
    menu["menu.go - Menu system"]
    toolview["toolview.go - Tool output"]
  end

  subgraph util_system["internal/util - Shared utilities"]
    diagnostics["diagnostics.go - File quality checks"]
    overflow["overflow.go - Overflow checks"]
    thinking["thinking.go - Chain of thought"]
    memory_sync["memory_sync.go - Wiki sync"]
    layout_struct["layout_struct.go - Layout structures"]
  end

  %% Access relationships
  kori_api -.-> cmd_directory
  kori_api -.-> tui_layer
  kori_config -.-> settings_directory
  kori_state -.-> storage_storage

  kori_inside_agent -.-> tools_layer
  kori_inside_agent -.-> workflow_layer

  cmd_sandbox -.-> sandbox_directory
  cmd_sandbox -.-> provider_directory

  agent_context -.-> sessions_system
  agent_context -.-> skills_system
  agent_context -.-> compaction_system

  agent_context -.-> cost_system
  agent_context -.-> history_system

  external_services -.-> herdr
  external_services -.-> sonde
  external_services -.-> journal
  external_services -.-> courrier
  external_services -.-> antenne

  agent_context -.-> workflow_layer

