  class main {
    "version: v0.72.0"
    Execute()
    UsageError handling
  }

  class cmd {
    Execute()
    Provide CLI commands
    Bind flags & options
    Orchestrate sessions
  }

  class md_g__agent {
    Core agent lifecycle
    Tool call routing
    Context isolation
    Session management
    Headless/interactive modes
  }

  class nacelle {
    External SDK
    Tool orchestration
    Execution skeleton
  }
  nacelle ..> agent_external : dependency

  class rigolo__Provider {
    chosen()
    DetectedProviders()
  }

  class rigolo__cosette__Backends {
    anthropic: Claude models
    google: Gemini models
    openai: GPT models
    openrouter: Multi-provider
  }

  class rigolo__Ensemble__ErrorException {
    UsageError
    Pass through from main->os.Exit
  }

  class rigolo__Ensemble__PassThrough {
    Return error to main
    os.Exit(1) for runtime
    os.Exit(2) for usage
  }

  note for main "Entry point\nParse flags → dispatch commands → return error"
  note for cmd "Orchestrator for:\n- root, remote, sandbox sessions\n- audit, search, configuration"
  note for rigolo__agent "Nacelle agent wrapper\nTool-call boundaries\nApproval gates\nSettings injection"
  note for rigolo__Provider+"+rigolo__cosette__Backends" "Provider selection from env keygers\nmodel-aware routing"
  note for rigolo__Ensemble__ErrorException "UsageError from agent → os.Exit(2)"
  note for rigolo__Ensemble__PassThrough "Runtime error from agent → os.Exit(1)"